<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Resturants List</h1>
    <ul>
        <% resturaunts.forEach(resturant => {%>
          <li><a href="/resturants/<%= resturant.id %>"><%= resturant.name %></a> 
            <% if(!resturant.isOpen){ %>  
                - Closed
                <% } %>
        </li>  
        
        <%}); %>
    </ul>
</body>
</html>